# ---------------------------------------------------------------------------
# ZeroAI Hub environment variables. Copy to .env.local for local development
# and add the same keys in Vercel > Project > Settings > Environment Variables.
# Never commit real secrets.
# ---------------------------------------------------------------------------

# Public URL of the site (no trailing slash). Used for the Paystack return URL and email links.
# Start with your Vercel URL (https://your-project.vercel.app) and change it when you add a domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings > API Keys)
# If you connect Supabase through the Vercel Marketplace integration, Vercel adds these for you as
# NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY and SUPABASE_SECRET_KEY; the app accepts either set of names.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The admin account. Logging in on the Admin tab with exactly these details creates the admin
# account the first time (or resets its password to this value). Keep ADMIN_PASSWORD secret.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Signed download links expire after this many seconds
SIGNED_URL_TTL_SECONDS=300

# Protects /api/cron/auto-accept. Vercel Cron sends it automatically as a Bearer token.
CRON_SECRET=generate-a-long-random-string

# Paystack (card payments in USD). Use sk_test_... until you go live.
PAYSTACK_SECRET_KEY=

# Email via Resend (optional). Without it, in-app notifications still work and emails are logged.
RESEND_API_KEY=
EMAIL_FROM="ZeroAI Hub <notifications@yourdomain.com>"
